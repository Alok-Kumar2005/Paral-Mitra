# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── External APIs ─────────────────────────────────────────────────────────────
FIRMS_MAP_KEY=
AWS_REGION=ap-south-1
MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Database mode ─────────────────────────────────────────────────────────────
# postgres | neon  ->  PostgresClient (Neon serverless Postgres, external to AWS)
# local           ->  InMemoryDatabase (fully offline, no credentials needed)
DB_MODE=local

# dev | prod
# scripts/reset_dev.py refuses to run unless DB_ENV=dev.
# InMemoryDatabase.clear_all() also checks this to prevent accidental wipes.
DB_ENV=dev

# ── Neon PostgreSQL (required when DB_MODE=postgres) ──────────────────────────
# Pooled connection URL — used by the Lambda runtime and the application.
# In AWS Lambda this is read from SSM SecureString /parali/database_url (cached at cold start).
# Locally it is read directly from this file.
DATABASE_URL=

# Non-pooled direct connection URL — used ONLY by scripts/migrate.py for DDL.
# Neon requires a direct (non-pooled) connection for CREATE TABLE / DDL statements.
DATABASE_URL_DIRECT=

# Throwaway Postgres URL for `pytest -m pg` storage contract tests.
# Each test run creates and destroys an isolated schema automatically.
TEST_DATABASE_URL=

# ── S3 (voice-note audio staging — deleted after transcription) ────────────────
# Used ONLY for temporary staging of farmer voice notes during Transcribe STT.
# Audio is uploaded to s3://<bucket>/voice/<chat_id>/<uuid>.ogg, transcribed,
# then immediately deleted. Never stored persistently. Not for application data.
S3_MEMORY_BUCKET=          # legacy alias (keep for backward compat)
S3_BUCKET_NAME=            # primary key used by voice_handler and template.yaml

# ── Voice feature flags ───────────────────────────────────────────────────────
# VOICE_REPLY_ENABLED: set to "true" to enable the 🔊 Listen button (Polly TTS).
# Defaults to "false" (off) to avoid unexpected Polly costs before testing.
# Supported languages: en (Kajal/Neural), hi (Aditi/Neural). pa has no Polly voice.
VOICE_REPLY_ENABLED=false

# ── Auth & Admin ──────────────────────────────────────────────────────────────
OWNER_PASSCODE=
ADMIN_CHAT_IDS=
